{
  "name": "dshsea-fish",
  "version": "0.1.0",
  "description": "Go fishing for DeepSeek Harness plugins. Tell the agent what you need; it casts into dshsea.com, an ocean of 30,000+ dsh plugins, and reels in a few installable ones that fit. It recommends and shows the install command; it never installs anything itself.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "plugin-discovery", "plugin-search", "dshsea", "fishing"],
  "author": "dshsea",
  "license": "MIT",
  "homepage": "https://dshsea.com",
  "repository": { "type": "git", "url": "git+https://github.com/dshsea/dshsea.git", "directory": "plugin" },
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node --check lib/index.js",
    "selftest": "node tools/selftest.mjs"
  },
  "dsh": {
    "category": "extension",
    "displayName": "dshsea fishing",
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7"
  }
}
