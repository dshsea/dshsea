---
// "What lives in my GitHub?" — every creature of one owner: /u/owner.
// Like the repo pages, production builds this once as a template that worker/index.js fills in;
// `astro dev` and STATIC_REPO_PAGES=1 builds render every owner directly.
import Base from '../../layouts/Base.astro';
import { ownerPages, type OwnerPage } from '../../lib/projects';

export function getStaticPaths() {
  if (import.meta.env.DEV || process.env.STATIC_REPO_PAGES) {
    return [...ownerPages().values()].map((page) => ({ params: { owner: page.KEY }, props: { page } }));
  }
  const keys = ['KEY', 'OWNER', 'COUNT', 'STARS', 'DEEPEST', 'META'];
  const page = { ...Object.fromEntries(keys.map((k) => [k, `__${k}__`])), L: [] } as unknown as OwnerPage;
  return [{ params: { owner: '_template' }, props: { page, template: true } }];
}
interface Props { page: OwnerPage; template?: boolean }
const { page: p, template = false } = Astro.props;
const esc = (s: string) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
// Keep in step with ownerRows() in worker/index.js.
const rows = template
  ? '__ROWS__'
  : p.L.map(([name, path, species, tint, speciesName, rarity, stars, depth]) =>
      `<li data-rarity="${rarity}"><a href="${esc(path)}"><img class="creature" src="/creatures/${species}.webp" style="--tint:${tint}deg" alt="" loading="lazy"><b>${esc(name)}</b><span>${esc(speciesName)} · ★ ${stars} · ${depth}</span></a></li>`).join('');
---
<Base lang="en" path={`/u/${p.KEY}`} title={`${p.OWNER}'s sea creatures — DeepSeek Harness plugins`} description={p.META} single noindex={template}>
  <main class="page">
    <nav class="crumbs"><a href="/">Ocean</a> <span>/</span> <a href="/u">Divers</a> <span>/</span> <span>{p.OWNER}</span></nav>
    <h1><em>{p.OWNER}</em>’s corner of the sea</h1>
    <p class="lede">
      <a href={`https://github.com/${p.OWNER}`} rel="noopener">{p.OWNER}</a> has {p.COUNT} DeepSeek Harness plugins in the ocean, with ★ {p.STARS} between them. The deepest lives {p.DEEPEST} down.
    </p>
    <div class="actions">
      <button class="btn" id="card-make" type="button" data-owner={p.OWNER} data-count={p.COUNT} data-stars={p.STARS} data-deepest={p.DEEPEST}>Make my card</button>
      <a class="btn alt" id="share" target="_blank" rel="noopener"
        href={`https://x.com/intent/post?text=${encodeURIComponent('My DeepSeek Harness plugins are sea creatures now 🐋')}&url=https://dshsea.com/u/${p.KEY}`}>Share on X</a>
      <a class="btn ghost" href="/u">Look up someone else</a>
    </div>
    <figure id="card-out" hidden>
      <img id="card-img" alt="Share card" />
      <figcaption><a class="btn" id="card-save" download>Save picture</a> <span>Save it, then attach it to your post.</span></figcaption>
    </figure>
    <ul class="school" id="school" set:html={rows} />
  </main>
  <script>
    // Draws the owner's creatures into one picture, entirely in the browser.
    const btn = document.getElementById('card-make')!;
    const load = (src: string) => new Promise<HTMLImageElement>((res, rej) => {
      const img = new Image();
      img.onload = () => res(img);
      img.onerror = rej;
      img.src = src;
    });
    btn.addEventListener('click', async () => {
      const d = btn.dataset;
      const items = [...document.querySelectorAll<HTMLImageElement>('#school img')].slice(0, 14);
      const W = 1600, H = 900;
      const cv = document.createElement('canvas');
      cv.width = W;
      cv.height = H;
      const g = cv.getContext('2d')!;
      const bg = g.createLinearGradient(0, 0, 0, H);
      bg.addColorStop(0, '#0d4a8c');
      bg.addColorStop(0.55, '#06204a');
      bg.addColorStop(1, '#020714');
      g.fillStyle = bg;
      g.fillRect(0, 0, W, H);
      // A loose grid, biggest creature first; odd rows are nudged sideways so it reads as a school.
      const imgs = await Promise.all(items.map((el) => load(el.src).catch(() => null)));
      const cols = Math.min(imgs.length, Math.max(2, Math.ceil(Math.sqrt(imgs.length * 2))));
      const rowsN = Math.ceil(imgs.length / cols);
      const cw = (W - 160) / cols, ch = Math.min(560 / rowsN, 420);
      imgs.forEach((img, i) => {
        if (!img) return;
        const col = i % cols, row = Math.floor(i / cols);
        const inRow = row === rowsN - 1 ? imgs.length - row * cols : cols;
        const x = W / 2 + (col - (inRow - 1) / 2) * cw + (row % 2 ? cw * 0.12 : 0);
        const y = 240 + (560 - rowsN * ch) / 2 + ch * (row + 0.5);
        const k = (Math.min(cw, ch * 1.3) * (i === 0 ? 0.92 : 0.8)) / Math.max(img.width, img.height);
        g.save();
        g.filter = `hue-rotate(${getComputedStyle(items[i]).getPropertyValue('--tint') || '0deg'}) drop-shadow(0 14px 22px rgba(0,0,0,.4))`;
        g.drawImage(img, x - (img.width * k) / 2, y - (img.height * k) / 2, img.width * k, img.height * k);
        g.restore();
      });
      const shade = g.createLinearGradient(0, 0, 0, 260);
      shade.addColorStop(0, 'rgba(2,7,20,.75)');
      shade.addColorStop(1, 'rgba(2,7,20,0)');
      g.fillStyle = shade;
      g.fillRect(0, 0, W, 260);
      await document.fonts.ready;
      g.fillStyle = '#fff';
      g.font = '400 96px "Instrument Serif", Georgia, serif';
      g.fillText(`${d.owner}’s sea`, 70, 130, W - 140);
      g.font = '500 30px Inter, system-ui, sans-serif';
      g.fillStyle = '#6ef3d6';
      g.fillText(`${d.count} creatures · ★ ${d.stars} · deepest ${d.deepest}`, 72, 184);
      g.textAlign = 'right';
      g.fillStyle = '#fff';
      g.font = 'italic 400 50px "Instrument Serif", Georgia, serif';
      g.fillText('dshsea.com', W - 70, H - 56);
      const url = cv.toDataURL('image/jpeg', 0.9);
      (document.getElementById('card-img') as HTMLImageElement).src = url;
      const save = document.getElementById('card-save') as HTMLAnchorElement;
      save.href = url;
      save.download = `dshsea-${d.owner}.jpg`;
      document.getElementById('card-out')!.hidden = false;
    });
  </script>
</Base>

<style>
  .crumbs { font-size: 13px; color: var(--dim); margin-bottom: 24px; }
  .crumbs a { color: var(--sky); text-decoration: none; }
  .crumbs span { margin: 0 4px; }
  h1 { overflow-wrap: anywhere; }
  .lede a { color: var(--sky); text-underline-offset: 3px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 34px; }
  figure { margin: 0 0 34px; }
  figure img { display: block; width: 100%; border-radius: 20px; border: 1px solid var(--line); }
  figcaption { display: flex; align-items: center; gap: 14px; margin-top: 14px; font-size: 14px; color: var(--dim); }
  .school { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
  .school :global(a) {
    display: flex; flex-direction: column; align-items: center; gap: 2px; text-align: center; text-decoration: none; height: 100%;
    padding: 14px 14px 18px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); transition: transform 0.25s, border-color 0.25s;
  }
  .school :global(a:hover) { transform: translateY(-3px); border-color: var(--line-strong); }
  .school :global(li[data-rarity='rare'] a) { border-color: rgba(110, 190, 255, 0.4); }
  .school :global(li[data-rarity='epic'] a) { border-color: rgba(190, 130, 255, 0.5); }
  .school :global(li[data-rarity='legendary'] a) { border-color: rgba(245, 210, 122, 0.6); }
  .school :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; margin-bottom: 6px; }
  .school :global(b) { font-weight: 600; overflow-wrap: anywhere; }
  .school :global(span) { font-size: 12px; color: var(--dim); font-variant-numeric: tabular-nums; }
</style>
