---
import Base from '../layouts/Base.astro';
import { dict, href, type Lang } from '../lib/i18n';
import { fmt, SITE, type Project } from '../lib/projects';
import { creatureSrc, tintStyle, zoneFor, fmtDepth } from '../lib/species';

interface Props { lang: Lang; project: Project }
const { lang, project: p } = Astro.props;
const t = dict(lang);
const desc = (lang === 'zh' && p.descriptionZh) || p.description;
const species = t.speciesNames[p.species];
const pagePath = `/p/${p.slug}`;
const pageUrl = SITE + href(lang, pagePath);
const tweet = t.shareTweet(p.name, lang === 'zh' ? species : species.toLowerCase(), fmtDepth(p.depth));
const shareUrl = `https://x.com/intent/post?text=${encodeURIComponent(tweet)}&url=${encodeURIComponent(pageUrl)}`;
const badge = `[![${p.name} on dshsea](${SITE}/badge/${p.slug}.svg)](${SITE}/p/${p.slug})`;
---
<Base
  lang={lang}
  path={pagePath}
  title={`${p.name} — ${species}, ${fmtDepth(p.depth)}`}
  description={desc}
  ogImage={`/og/${p.slug}.png`}
>
  <main class="page">
    <article class="hero" data-rarity={p.rarity}>
      <div class="tank" style={`--hue:${p.hue}`}>
        <img class="creature" src={creatureSrc(p.species)} style={tintStyle(p.hue)} alt={`${p.name}: ${species}`} />
        <canvas id="viewer" data-species={p.species} data-hue={p.hue} aria-hidden="true"></canvas>
        <span class="drag">{t.dragHint}</span>
      </div>
      <div class="info">
        <span class="chip" data-rarity={p.rarity}>{species} · {t.rarityNames[p.rarity]}</span>
        <h1>{p.name}</h1>
        <p class="lives">{t.livesAt(fmtDepth(p.depth))} · {t.zones[zoneFor(p.depth)]}</p>
        <p class="desc">{desc}</p>
        <dl>
          <div><dt>{t.stars}</dt><dd>★ {fmt(p.stars)}</dd></div>
          <div><dt>{t.category}</dt><dd>{(t.categoryNames as any)[p.category]}</dd></div>
          {p.author && <div><dt>{t.author}</dt><dd>{p.author}</dd></div>}
        </dl>
        <div class="actions">
          <a class="btn" href={p.url} rel="noopener" target="_blank">{t.visit} ↗</a>
          <a class="btn alt" href={shareUrl} rel="noopener" target="_blank">{t.share}</a>
          <a class="btn ghost" href={`${href(lang, '/')}?seek=${p.slug}`}>{t.diveTo}</a>
        </div>
      </div>
    </article>

    <h2>{t.badgeTitle}</h2>
    <p class="lede">{t.badgeSub}</p>
    <p><img src={`/badge/${p.slug}.svg`} alt="dshsea badge" height="28" /></p>
    <div class="copy">
      <pre class="code" id="badge-code">{badge}</pre>
      <button class="btn alt" id="copy" data-done={t.copied}>{t.copy}</button>
    </div>
  </main>
  <script>
    const btn = document.getElementById('copy')!;
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(document.getElementById('badge-code')!.textContent ?? '');
      const label = btn.textContent;
      btn.textContent = btn.dataset.done!;
      setTimeout(() => (btn.textContent = label), 1500);
    });

    // Upgrade the still image to a live, draggable 3D creature when WebGL2 is there.
    const canvas = document.getElementById('viewer') as HTMLCanvasElement;
    let ok = false;
    try {
      ok = !!document.createElement('canvas').getContext('webgl2');
    } catch {}
    if (ok) {
      import('./viewer')
        .then((m) => {
          m.mountViewer(canvas, canvas.dataset.species as any, Number(canvas.dataset.hue), { interactive: true });
          canvas.parentElement!.classList.add('live');
        })
        .catch(() => {});
    }
  </script>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 40px; align-items: center; }
  .tank {
    position: relative; aspect-ratio: 4 / 3; border-radius: 28px; overflow: hidden; border: 1px solid var(--line);
    background:
      radial-gradient(60% 60% at 50% 46%, hsl(calc(var(--hue) * 1deg) 80% 60% / 0.28), transparent 70%),
      linear-gradient(160deg, rgba(20, 60, 120, 0.55), rgba(4, 12, 34, 0.8));
  }
  .hero[data-rarity='legendary'] .tank { border-color: rgba(245, 210, 122, 0.45); }
  .tank img, .tank canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tank img { object-fit: contain; padding: 6%; animation: float 5s ease-in-out infinite; }
  .tank canvas { opacity: 0; transition: opacity 0.6s; }
  .tank.live canvas { opacity: 1; }
  .tank.live img { opacity: 0; animation: none; transition: opacity 0.4s; }
  .drag {
    position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--dim); opacity: 0; transition: opacity 0.6s 0.6s; pointer-events: none;
  }
  .tank.live .drag { opacity: 0.8; }
  @keyframes float { 50% { transform: translateY(-10px); } }
  @media (prefers-reduced-motion: reduce) { .tank img { animation: none; } }
  .info { min-width: 0; }
  .info h1 { margin: 16px 0 10px; overflow-wrap: anywhere; font-size: clamp(40px, 5.4vw, 68px); }
  .lives { margin: 0 0 18px; color: var(--glow); font-size: 15px; }
  .desc { margin: 0 0 24px; color: #c9d9f0; font-size: 17px; overflow-wrap: anywhere; }
  dl { display: flex; flex-wrap: wrap; gap: 30px; margin: 0 0 28px; padding-top: 20px; border-top: 1px solid var(--line); }
  dt { font-size: 10px; color: var(--dim); text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 2px; }
  dd { margin: 0; font-weight: 500; font-variant-numeric: tabular-nums; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .copy { display: flex; gap: 12px; align-items: stretch; }
  .copy pre { flex: 1; min-width: 0; }
  .copy .btn { border-radius: 14px; }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; gap: 24px; }
    .copy { flex-direction: column; }
    .copy .btn { justify-content: center; }
  }
</style>
