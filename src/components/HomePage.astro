---
import Base from '../layouts/Base.astro';
import { dict, href, prefix, type Lang } from '../lib/i18n';
import { getCatalog, getProjects, CHUNK, fmt } from '../lib/projects';
import { depthOf, fmtDepth } from '../lib/species';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
const { entries } = getCatalog();
const projects = getProjects();
const count = entries.length;
const seabed = depthOf(Math.max(count - 1, 0)) + 420;
// The giants, marked on the depth gauge.
const landmarks = entries
  .map((e, i) => [i, e.name, e.stars] as [number, string, number])
  .sort((a, b) => b[2] - a[2])
  .slice(0, 36);

const payload = {
  base: prefix(lang),
  meta: { count, chunk: CHUNK, landmarks },
  claimed: Object.fromEntries(projects.map((p) => [p.slug, p.index])),
  // Used by the no-WebGL fallback, which only shows claimed creatures.
  creatures: projects.map((p) => ({
    slug: p.slug, name: p.name, desc: (lang === 'zh' && p.descriptionZh) || p.description,
    stars: p.stars, depth: p.depth, species: p.species, hue: p.hue, rarity: p.rarity, url: p.url,
  })),
  t: {
    zones: t.zones, speciesNames: t.speciesNames, rarityNames: t.rarityNames,
    ghostLabel: t.ghostLabel, sonarNone: t.sonarNone, hintMouse: t.hintMouse, hintTouch: t.hintTouch,
    newSpecies: t.newSpecies, noDesc: t.noDesc, wild: t.wild, claimed: t.claimed, claim: t.claim, details: t.details,
    shareTweet: t.shareTweet('{name}', '{species}', '{depth}'),
  },
};
const eggShare = `https://x.com/intent/post?text=${encodeURIComponent(t.eggTweet(fmtDepth(seabed)))}&url=${encodeURIComponent('https://dshsea.com' + href(lang, '/'))}`;
---
<Base lang={lang} path="/" ocean>
  <div class="sonar-wrap" slot="bar">
    <input id="sonar" type="search" autocomplete="off" spellcheck="false" placeholder={t.sonarPlaceholder} aria-label={t.sonarPlaceholder} />
    <div id="sonar-results" hidden></div>
  </div>

  <canvas id="ocean" aria-hidden="true"></canvas>

  <main>
    <section class="hero">
      <p class="kicker">{t.heroKicker}</p>
      <h1>{t.heroTitle1} <em>{t.heroTitle2}</em></h1>
      <p class="sub">{t.heroSub(fmt(count))}</p>
      <a class="btn" href={href(lang, '/submit')}>{t.heroCta} →</a>
    </section>
    <p class="scroll"><span></span>{t.scrollHint}</p>
    <div id="ocean-spacer"></div>

    <!-- The same catalogue as plain links, for crawlers, screen readers and no-JS. -->
    <nav class="sr-only" aria-label={t.listTitle}>
      <ul>
        {projects.map((p) => (
          <li><a href={href(lang, `/p/${p.slug}`)}>{p.name}</a> — {p.description}</li>
        ))}
      </ul>
    </nav>
  </main>

  <aside class="gauge" aria-hidden="true">
    <div id="gauge-bar">
      <div id="gauge-dots"></div>
      <div id="gauge-marker"></div>
    </div>
    <div class="readout">
      <strong id="gauge-depth">0 m</strong>
      <span id="gauge-zone">{t.zones.sunlight}</span>
    </div>
  </aside>

  <div class="helm">
    <button id="rise" type="button" title={t.rise} aria-label={t.rise}>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 10l5-5 5 5"/></svg>
    </button>
    <button id="dive" type="button" title={t.dive}>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3 6l5 5 5-5"/></svg>
      {t.dive}
    </button>
    <button id="random" type="button" title={t.random}>
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M2 4h2.5c3 0 4 8 7 8H14M2 12h2.5c1.2 0 2-1.2 2.8-2.6M9.2 6.3C9.9 5 10.6 4 11.5 4H14M12.2 2.2L14 4l-1.8 1.8M12.2 10.2L14 12l-1.8 1.8"/></svg>
      {t.random}
    </button>
  </div>
  <p class="logbook" aria-live="off">
    <span><b id="log-seen">0</b> / {fmt(count)} {t.logSeen}</span>
    <span><b id="log-species">0</b> {t.logSpecies}</span>
    <span>{t.logDeepest} <b id="log-deepest">0 m</b></span>
  </p>
  <p id="toast" role="status"></p>
  <p id="hint" aria-hidden="true"></p>
  <button id="sound" type="button" aria-pressed="false" hidden>
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M2 6h2.5L8 3v10L4.5 10H2zM10 5.2a4 4 0 0 1 0 5.6l-.9-.9a2.7 2.7 0 0 0 0-3.8zM12 3.3a6.6 6.6 0 0 1 0 9.4l-.9-.9a5.3 5.3 0 0 0 0-7.6z"/></svg>
    {t.sound}
  </button>

  <section id="card" hidden>
    <button id="card-close" aria-label="Close">×</button>
    <div class="head">
      <img id="card-img" class="creature" alt="" />
      <div>
        <span id="card-kind" class="chip"></span>
        <h2 id="card-name"></h2>
      </div>
    </div>
    <p id="card-desc"></p>
    <dl>
      <div><dt>{t.depth}</dt><dd id="card-depth"></dd></div>
      <div><dt>{t.stars}</dt><dd id="card-stars"></dd></div>
      <div><dt>{t.status}</dt><dd id="card-status"></dd></div>
    </dl>
    <div class="actions">
      <a id="card-visit" class="btn" target="_blank" rel="noopener">{t.visit} ↗</a>
      <a id="card-share" class="btn alt" target="_blank" rel="noopener">{t.share}</a>
      <a id="card-details" class="btn ghost">{t.details}</a>
    </div>
  </section>

  <section id="egg" hidden>
    <button id="egg-close" aria-label="Close">×</button>
    <h2>{t.eggTitle}</h2>
    <p class="depth" id="egg-depth">{fmtDepth(seabed)}</p>
    <p>{t.eggBody}</p>
    <a class="btn" href={eggShare} target="_blank" rel="noopener">{t.eggShare}</a>
  </section>

  <script type="application/json" id="ocean-data" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
  <script>
    // 3D when WebGL2 is available, otherwise (or with ?2d) a lightweight fallback.
    const start2d = () => import('./ocean').then((m) => m.initOcean());
    const webgl = (() => {
      try {
        return !!document.createElement('canvas').getContext('webgl2');
      } catch {
        return false;
      }
    })();
    const params = new URLSearchParams(location.search);
    if (import.meta.env.DEV && params.has('studio')) {
      // Dev only: a bare creature on a transparent page, photographed by scripts/render-species.mjs.
      document.body.classList.add('studio');
      import('./viewer').then((m) => {
        m.mountViewer(document.getElementById('ocean') as HTMLCanvasElement, params.get('studio') as any, Number(params.get('hue') ?? 200), { still: true });
        requestAnimationFrame(() => requestAnimationFrame(() => document.body.classList.add('studio-ready')));
      });
    } else if (webgl && !params.has('2d')) {
      import('./ocean3d')
        .then((m) => m.initOcean3D())
        .catch((err) => {
          console.warn('3D ocean failed, falling back', err);
          return start2d();
        });
    } else start2d();
  </script>
</Base>

<style>
  #ocean { position: fixed; inset: 0; width: 100vw; height: 100vh; height: 100dvh; z-index: 0; display: block; }
  main { position: relative; pointer-events: none; }
  :global(body.ocean-3d) { overflow: hidden; height: 100dvh; overscroll-behavior: none; }
  :global(body.ocean-3d) #ocean-spacer { display: none; }
  :global(body.ocean-3d) .hero { position: fixed; }

  :global(body.studio), :global(html:has(body.studio)) { background: transparent !important; }
  :global(body.studio > *:not(#ocean)) { display: none !important; }
  :global(#splash) { position: fixed; inset: 0; z-index: 5; pointer-events: none; opacity: 0; background: radial-gradient(circle at 50% 60%, #eaffff, #7fe3f5 60%, #2aa9cc); }
  :global(#splash.go) { animation: splash 0.7s ease-out; }
  @keyframes splash { 0% { opacity: 0.85; } 100% { opacity: 0; } }

  .hero {
    position: absolute; top: 0; left: 0; right: 0; height: 58vh; z-index: 2;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 64px 20px 0; gap: 14px;
  }
  .hero > * { margin: 0; }
  .hero a { pointer-events: auto; }
  .kicker { font-size: 12px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(255, 236, 220, 0.86); }
  .hero h1 {
    font-family: var(--display); font-weight: 400; line-height: 0.92; letter-spacing: -0.035em;
    font-size: clamp(72px, 15vw, 190px); color: #fff; text-shadow: 0 6px 60px rgba(40, 14, 80, 0.5);
  }
  .hero h1 em { color: #8ff8e1; text-shadow: 0 0 60px rgba(110, 243, 214, 0.45); }
  .sub { font-size: clamp(16px, 2vw, 20px); color: rgba(255, 255, 255, 0.92); text-shadow: 0 1px 14px rgba(40, 14, 80, 0.6); margin-bottom: 6px; }
  .scroll {
    position: fixed; left: 50%; bottom: 30px; transform: translateX(-50%); z-index: 3; margin: 0; pointer-events: none;
    display: flex; flex-direction: column-reverse; align-items: center; gap: 10px; transition: opacity 0.4s;
    font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
  }
  :global(body.dived) .scroll, :global(body.ocean-2d) .scroll { opacity: 0; }
  .scroll span { width: 1px; height: 30px; background: linear-gradient(rgba(255, 255, 255, 0), #fff); animation: drip 1.9s ease-in-out infinite; transform-origin: top; }
  @keyframes drip { 0% { transform: scaleY(0); opacity: 0; } 40% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1) translateY(14px); opacity: 0; } }
  @media (max-height: 640px) { .kicker { display: none; } }
  :global(html[lang^='zh']) .kicker { letter-spacing: 0.4em; }

  .sonar-wrap { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12px; max-width: 440px; margin: 0 auto; }
  #sonar {
    flex: 1; min-width: 0; font: 14px var(--body); color: var(--text); outline: none;
    background: rgba(8, 18, 42, 0.45); border: 1px solid var(--line); border-radius: 999px; padding: 9px 18px;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: border-color 0.2s, background 0.2s;
  }
  #sonar:focus { border-color: rgba(110, 243, 214, 0.7); background: rgba(8, 18, 42, 0.7); }
  #sonar::placeholder { color: rgba(200, 220, 245, 0.6); }
  .sonar-wrap { position: relative; }
  #sonar-results {
    position: absolute; top: calc(100% + 8px); left: 0; right: 0; padding: 6px; font-size: 13px; color: var(--dim);
    background: rgba(8, 18, 42, 0.86); border: 1px solid var(--line-strong); border-radius: 16px;
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
  }
  #sonar-results:not(:has(button)) { padding: 12px 16px; }
  #sonar-results :global(button) {
    display: flex; width: 100%; justify-content: space-between; gap: 14px; align-items: baseline; text-align: left; cursor: pointer;
    font: 14px var(--body); color: var(--text); background: none; border: 0; border-radius: 10px; padding: 9px 12px;
  }
  #sonar-results :global(button:hover), #sonar-results :global(button:first-child) { background: rgba(110, 243, 214, 0.1); }
  #sonar-results :global(button span) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #sonar-results :global(button small) { flex: none; color: var(--glow); font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) {
    .sonar-wrap { order: 3; flex-basis: 100%; max-width: none; }
  }

  .gauge {
    position: fixed; left: 22px; top: 50%; transform: translateY(-50%); z-index: 10;
    display: flex; align-items: center; gap: 14px; opacity: 0; transition: opacity 0.5s; pointer-events: none;
  }
  :global(body.dived) .gauge { opacity: 1; pointer-events: auto; }
  #gauge-bar { position: relative; width: 12px; height: 54vh; cursor: pointer; }
  #gauge-bar::before { content: ''; position: absolute; left: 5px; top: 0; bottom: 0; width: 2px; border-radius: 2px; background: rgba(170, 205, 255, 0.22); }
  #gauge-dots :global(i) { position: absolute; left: 4px; width: 4px; height: 4px; margin-top: -2px; border-radius: 50%; background: var(--gold); opacity: 0.75; }
  #gauge-marker { position: absolute; left: 0; width: 12px; height: 12px; margin-top: -6px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.16), 0 0 16px rgba(255, 255, 255, 0.8); }
  .readout { display: flex; flex-direction: column; gap: 2px; text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6); }
  .readout strong { font-family: var(--display); font-size: 30px; font-weight: 400; line-height: 1; color: #fff; font-variant-numeric: tabular-nums; }
  .readout span { font-size: 11px; color: var(--dim); letter-spacing: 0.18em; text-transform: uppercase; }
  @media (max-width: 640px) {
    .gauge { left: 10px; gap: 10px; }
    #gauge-bar { height: 42vh; }
    .readout strong { font-size: 22px; }
    .readout span { display: none; }
  }

  .helm { position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%); z-index: 12; display: flex; gap: 10px; align-items: center; opacity: 0; transition: opacity 0.5s; pointer-events: none; }
  :global(body.dived) .helm { opacity: 1; pointer-events: auto; }
  .helm button {
    display: inline-flex; align-items: center; gap: 8px; font: 500 13px var(--body); color: var(--text); cursor: pointer; user-select: none; -webkit-user-select: none; touch-action: none;
    background: rgba(8, 18, 42, 0.55); border: 1px solid var(--line-strong); border-radius: 999px; padding: 11px 16px;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: background 0.2s, color 0.2s, transform 0.2s;
  }
  .helm button:hover { background: rgba(20, 44, 90, 0.7); }
  .helm :global(button.held) { color: #03131f; background: var(--glow); border-color: var(--glow); transform: scale(0.97); }
  .helm #rise { padding: 11px; }
  .logbook {
    position: fixed; left: 50%; top: 66px; transform: translateX(-50%); z-index: 9; margin: 0; display: flex; gap: 18px; white-space: nowrap;
    font-size: 12px; color: var(--dim); opacity: 0; transition: opacity 0.5s; pointer-events: none; text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
  .logbook b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }
  :global(body.dived.ocean-3d) .logbook { opacity: 1; }
  #toast {
    position: fixed; left: 50%; top: 98px; transform: translate(-50%, -8px); z-index: 14; margin: 0; pointer-events: none;
    font-size: 14px; font-weight: 500; color: #03131f; background: linear-gradient(135deg, #8af7df, #6cc8ff); border-radius: 999px; padding: 9px 18px;
    box-shadow: 0 10px 34px rgba(110, 243, 214, 0.35); opacity: 0; transition: opacity 0.4s, transform 0.4s; white-space: nowrap;
  }
  :global(#toast.show) { opacity: 1; transform: translate(-50%, 0); }
  :global(#splash.dark) { background: #020714; }
  @media (max-width: 640px) {
    .helm { left: auto; right: 10px; bottom: 12px; transform: none; }
    .helm button { font-size: 12px; padding: 10px 13px; }
    .helm #random { font-size: 0; gap: 0; padding: 10px; }
    .logbook { top: 104px; gap: 12px; font-size: 11px; }
    #toast { top: 132px; font-size: 13px; }
  }
  #hint {
    position: fixed; left: 50%; bottom: 82px; transform: translateX(-50%); z-index: 9; margin: 0; pointer-events: none;
    font-size: 13px; color: #dff6ff; background: rgba(8, 18, 42, 0.6); border: 1px solid var(--line); border-radius: 999px; padding: 9px 18px;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    opacity: 0; transition: opacity 0.8s; white-space: nowrap; max-width: calc(100vw - 24px); overflow: hidden; text-overflow: ellipsis;
  }
  :global(#hint.show) { opacity: 1; }
  #sound {
    position: fixed; left: 22px; bottom: 22px; z-index: 12; display: inline-flex; align-items: center; gap: 7px;
    font: 500 12px var(--body); color: var(--dim); cursor: pointer;
    background: rgba(8, 18, 42, 0.55); border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: color 0.2s, background 0.2s;
  }
  #sound[aria-pressed='true'] { color: #03131f; background: var(--glow); border-color: var(--glow); }
  @media (max-width: 640px) {
    .helm { position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%); z-index: 12; display: flex; gap: 10px; align-items: center; opacity: 0; transition: opacity 0.5s; pointer-events: none; }
  :global(body.dived) .helm { opacity: 1; pointer-events: auto; }
  .helm button {
    display: inline-flex; align-items: center; gap: 8px; font: 500 13px var(--body); color: var(--text); cursor: pointer; user-select: none; -webkit-user-select: none; touch-action: none;
    background: rgba(8, 18, 42, 0.55); border: 1px solid var(--line-strong); border-radius: 999px; padding: 11px 16px;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: background 0.2s, color 0.2s, transform 0.2s;
  }
  .helm button:hover { background: rgba(20, 44, 90, 0.7); }
  .helm :global(button.held) { color: #03131f; background: var(--glow); border-color: var(--glow); transform: scale(0.97); }
  .helm #rise { padding: 11px; }
  .logbook {
    position: fixed; left: 50%; top: 66px; transform: translateX(-50%); z-index: 9; margin: 0; display: flex; gap: 18px; white-space: nowrap;
    font-size: 12px; color: var(--dim); opacity: 0; transition: opacity 0.5s; pointer-events: none; text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
  .logbook b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }
  :global(body.dived.ocean-3d) .logbook { opacity: 1; }
  #toast {
    position: fixed; left: 50%; top: 98px; transform: translate(-50%, -8px); z-index: 14; margin: 0; pointer-events: none;
    font-size: 14px; font-weight: 500; color: #03131f; background: linear-gradient(135deg, #8af7df, #6cc8ff); border-radius: 999px; padding: 9px 18px;
    box-shadow: 0 10px 34px rgba(110, 243, 214, 0.35); opacity: 0; transition: opacity 0.4s, transform 0.4s; white-space: nowrap;
  }
  :global(#toast.show) { opacity: 1; transform: translate(-50%, 0); }
  :global(#splash.dark) { background: #020714; }
  @media (max-width: 640px) {
    .helm { left: auto; right: 10px; bottom: 12px; transform: none; }
    .helm button { font-size: 12px; padding: 10px 13px; }
    .helm #random { font-size: 0; gap: 0; padding: 10px; }
    .logbook { top: 104px; gap: 12px; font-size: 11px; }
    #toast { top: 132px; font-size: 13px; }
  }
  #hint { bottom: 70px; font-size: 12px; white-space: normal; text-align: center; border-radius: 16px; }
    #sound { left: 10px; bottom: 12px; }
  }

  #card, #egg {
    position: fixed; z-index: 30; right: 24px; bottom: 24px; width: min(400px, calc(100vw - 24px));
    background: rgba(8, 18, 42, 0.72); border: 1px solid var(--line-strong); border-radius: 22px; padding: 22px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5); backdrop-filter: blur(22px) saturate(1.3); -webkit-backdrop-filter: blur(22px) saturate(1.3);
    animation: rise 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
  #card[data-rarity='legendary'] { border-color: rgba(245, 210, 122, 0.55); }
  #card .head { display: flex; align-items: center; gap: 16px; margin-right: 26px; }
  #card-img { width: 116px; height: 88px; object-fit: contain; flex: none; }
  #card h2 { font-family: var(--display); font-weight: 400; font-size: 28px; line-height: 1.1; letter-spacing: -0.01em; margin: 8px 0 0; overflow-wrap: anywhere; }
  #card-kind { color: var(--glow); background: rgba(110, 243, 214, 0.12); }
  #card-desc { font-size: 14px; line-height: 1.6; color: #c9d9f0; margin: 16px 0; max-height: 8em; overflow: auto; }
  #card dl { display: flex; gap: 26px; margin: 0 0 20px; padding-top: 16px; border-top: 1px solid var(--line); }
  #card dt { font-size: 10px; color: var(--dim); text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 2px; }
  #card dd { margin: 0; font-size: 15px; font-weight: 500; font-variant-numeric: tabular-nums; }
  #card .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  #card .actions .btn { padding: 11px 16px; }
  #card-close, #egg-close {
    position: absolute; top: 12px; right: 12px; width: 30px; height: 30px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(255, 255, 255, 0.08); color: var(--dim); font-size: 18px; line-height: 1;
  }
  #card-close:hover, #egg-close:hover { color: #fff; background: rgba(255, 255, 255, 0.16); }
  #egg { right: 50%; bottom: 50%; transform: translate(50%, 50%); border-color: rgba(245, 210, 122, 0.55); text-align: center; padding: 32px 28px; animation: none; }
  #egg h2 { font-family: var(--display); font-weight: 400; font-size: 36px; line-height: 1.1; margin: 0; }
  #egg p { font-size: 15px; color: #c9d9f0; margin: 12px 0 22px; }
  #egg .depth { font-family: var(--display); font-size: 44px; line-height: 1; color: var(--gold); margin: 10px 0 0; }
  #card[data-wild='true'] #card-details { color: var(--glow); box-shadow: inset 0 0 0 1px rgba(110, 243, 214, 0.5); }
